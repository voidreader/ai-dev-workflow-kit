#!/usr/bin/env ruby
# android/fastlane/set_contact_details.rb — Play 스토어 리스팅의 연락처
# 이메일 + 웹사이트를 Android Publisher API로 설정한다(supply에는 해당 필드가 없음).
# 실행: `cd android && ruby fastlane/set_contact_details.rb`.
# ship-submit가 __PACKAGE__, __EMAIL__, __WEBSITE__를 인자로 채운다.
require 'google/apis/androidpublisher_v3'
require 'googleauth'

AP = Google::Apis::AndroidpublisherV3
PKG = '__PACKAGE__'
KEY = File.expand_path('play-store-key.json', __dir__)

svc = AP::AndroidPublisherService.new
svc.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
  json_key_io: File.open(KEY),
  scope: 'https://www.googleapis.com/auth/androidpublisher',
)

edit = svc.insert_edit(PKG)
details = svc.get_edit_detail(PKG, edit.id)
details.contact_email = '__EMAIL__'
details.contact_website = '__WEBSITE__'
svc.update_edit_detail(PKG, edit.id, details)
svc.commit_edit(PKG, edit.id)
puts "OK: contact email=#{details.contact_email} site=#{details.contact_website}"
